apiVersion: argoproj.io/v1alpha1
kind: ApplicationSet
metadata:
  name: applicationset-prod
  namespace: argocd
spec:
  generators:
    - list:
        elements:
          - name: ingress-nginx
            namespace: ingress-nginx
          - name: cert-manager
            namespace: cert-manager
          - name: redis
            namespace: redis
  template:
    metadata:
      name: '{{name}}-{{env}}' # Application name = folder name
    spec:
      project: default
      source:
        repoURL: 'https://github.com/alexneuman/scrapy-pipeline-cluster-infrastructure.git'
        targetRevision: test
        path: 'k8s/helm/charts/{{name}}'         # folder containing the chart
        helm:
          valueFiles:
            - "../../charts/{{name}}/values.yaml"
            - "../../values/prod/{{name}}/values.yaml"       # values file in each chart folder
      destination:
        server: https://kubernetes.default.svc
        namespace: '{{namespace}}'  # deploy each chart to its own namespace
      syncPolicy:
        automated:
          prune: true
          selfHeal: true
        syncOptions:
          - CreateNamespace=true